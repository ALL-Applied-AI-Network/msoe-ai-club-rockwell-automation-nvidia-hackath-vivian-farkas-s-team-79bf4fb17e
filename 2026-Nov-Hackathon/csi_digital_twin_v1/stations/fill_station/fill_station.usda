#usda 1.0
(
    subLayers = [@geometry/fill_station.usdc@]
    defaultPrim = "FillStation"
    metersPerUnit = 1
    upAxis = "Z"
    framesPerSecond = 30
    timeCodesPerSecond = 30
    startTimeCode = 1
    endTimeCode = 686
)
over "FillStation" {
    over "FillStation_LocalRoot" {
        over "Fill_dispensing_stream" {
            token visibility.timeSamples = {
                1: "invisible",
                12: "inherited",
                368: "invisible",
                586: "inherited",
                661: "invisible",
            }
        }
        over "Fill_liquid" {
            token visibility.timeSamples = {
                1: "invisible",
                21: "inherited",
            }
        }
        over "Fill_vial_neighbour_2" {
            token visibility.timeSamples = {
                1: "invisible",
                181: "inherited",
            }
        }
    }
}
